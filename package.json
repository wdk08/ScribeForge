{
  "name": "scribeforge",
  "version": "1.0.2",
  "private": true,
  "type": "module",
  "description": "Local prose-writing room for macOS, Windows, and the browser",
  "scripts": {
    "start": "npm run dev:browser",
    "dev:browser": "node scripts/server.mjs",
    "dev:mac": "tauri dev --config src-tauri/tauri.local.conf.json",
    "desktop:dev": "tauri dev --config src-tauri/tauri.local.conf.json",
    "build:browser": "node scripts/build-browser.mjs",
    "build:desktop": "node scripts/build-desktop.mjs desktop",
    "build:desktop:dev": "node scripts/build-desktop.mjs desktop --dev",
    "check": "node scripts/check.mjs",
    "test": "node --test tests/scribeforge/*.test.js",
    "test:browser": "playwright test",
    "test:desktop": "npm run build:desktop:dev && cargo test --manifest-path src-tauri/Cargo.toml",
    "tauri": "tauri",
    "release": "node scripts/release.mjs",
    "verify:release": "node scripts/verify-scribeforge-release.mjs",
    "test:pages": "playwright test --config playwright.pages.config.js"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tauri-apps/cli": "^2.12.3",
    "fake-indexeddb": "^6.2.5",
    "vite": "7.3.7"
  },
  "dependencies": {
    "esbuild": "0.28.2",
    "fflate": "0.8.3",
    "jspdf": "4.2.1",
    "prosemirror-commands": "1.7.2",
    "prosemirror-history": "1.5.1",
    "prosemirror-keymap": "1.2.3",
    "prosemirror-model": "1.25.13",
    "prosemirror-state": "1.4.4",
    "prosemirror-view": "1.42.9"
  },
  "license": "GPL-3.0-only",
  "author": "Forge Studios"
}
